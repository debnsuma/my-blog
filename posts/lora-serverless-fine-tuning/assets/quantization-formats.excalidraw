      "boundElements": null,
      "updated": 1722400000000,
      "link": null,
      "locked": false,
      "text": "Every format is a fixed bit budget. Fewer bits per parameter = less storage,\nand the budget split decides whether range or precision pays for it.",
      "fontSize": 13.5,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every format is a fixed bit budget. Fewer bits per parameter = less storage,\nand the budget split decides whether range or precision pays for it.",
